{
  "expo": {
    "name": "Teyvat Delicacies",
    "slug": "teyvat-delicacies",
    "scheme": "teyvat-delicacies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECE5D8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#272E42"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.darrahman.teyvatdelicacies",
      "adaptiveIcon": {
        "backgroundColor": "#272E42",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen"
    ]
  }
}
